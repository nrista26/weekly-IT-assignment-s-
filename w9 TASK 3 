<html>
<head>
<style>
/* Basic font for the whole page */
body {
font-family: Arial;
}

/* Top bar holding logo and navigation menu */
div.top {
overflow: hidden;
border-bottom: 1px solid black;
padding: 10px;
}
/* overflow:hidden makes this div stretch to contain the floated logo and nav inside it -
   without it, the div would collapse to 0 height because floated items don't count normally */

/* Logo placeholder box on the left */
div.logo {
width: 100px;
height: 60px;
border: 1px solid black;
text-align: center;
float: left;
}
/* float:left pushes the logo to the left side of the top bar */

/* Navigation menu container on the right */
div.nav {
float: right;
}
/* float:right pushes the whole nav menu to the right side, opposite the logo */

/* Individual navigation links styled like buttons */
div.nav a {
float: left;
margin-left: 5px;
border: 1px solid black;
padding: 5px;
text-decoration: none;
color: black;
}
/* float:left makes the links sit next to each other in a row instead of stacking */

/* Section heading */
h2 {
clear: both;
padding-left: 10px;
}
/* clear:both makes sure this heading starts below the floated top bar, not next to it */

/* Each company info box */
div.card {
width: 400px;
background-color: #f2f2f2;
float: left;
margin: 10px;
padding: 10px;
}
/* float:left lets the cards sit two per row, matching the wireframe layout */

/* Small logo placeholder inside each card */
div.cardimg {
width: 80px;
height: 80px;
border: 1px solid black;
text-align: center;
float: left;
margin-right: 10px;
}
/* float:left lets the text next to it (company name, CEO) sit beside the image */

/* Footer section at the bottom with 3 columns */
div.footer {
clear: both;
border-top: 1px solid black;
padding: 10px;
overflow: hidden;
}
/* clear:both makes sure footer appears below the cards, not floating next to them */
/* overflow:hidden keeps this div tall enough to contain the floated footer columns inside */

/* Each column inside the footer (site map, testimonials, contact info) */
div.footercol {
width: 250px;
float: left;
padding: 10px;
}
/* float:left arranges the 3 footer sections side by side */

/* Google Map placeholder box */
div.mapimg {
width: 150px;
height: 90px;
border: 1px solid black;
text-align: center;
float: left;
margin-right: 10px;
}
</style>
</head>
