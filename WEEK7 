# Use table and FORM ELEMETS TO MAKE A REGISTRATION FORM 
<html>
<head>
    <title>Registration Form</title>
</head>
<body>

<h1>Registration Form</h1>

<form>
    <table>

        <tr>
            <td><label>First Name:</label></td>
            <td><input type="text" placeholder="Enter your name"></td>
        </tr>

        <tr>
            <td><label>Last Name:</label></td>
            <td><input type="text" placeholder="Enter your last name"></td>
        </tr>

        <tr>
            <td><label>Password:</label></td>
            <td><input type="password" placeholder="Enter password"></td>
        </tr>

        <tr>
            <td><label>Re-enter Password:</label></td>
            <td><input type="password" placeholder="Re-enter password"></td>
        </tr>

        <tr>
            <td><label>Email:</label></td>
            <td><input type="email" placeholder="Enter your email"></td>
        </tr>

        <tr>
            <td><label>Number:</label></td>
            <td><input type="number" placeholder="Enter your number"></td>
        </tr>

        <tr>
            <td><label>Address:</label></td>
            <td><input type="text" placeholder="Enter your address"></td>
        </tr>

        <tr>
            <td><label>Gender:</label></td>
            <td>
                <input type="radio" name="gender"> Male
                <input type="radio" name="gender"> Female
                <input type="radio" name="gender"> others 
            </td>
        </tr>

        <tr>
            <td><label>Hobbies:</label></td>
            <td>
                <input type="checkbox"> Reading
                <input type="checkbox"> Music
                <input type="checkbox"> Dancing
                <input type="checkbox"> Gaming
            </td>
        </tr>
        <tr>
            <td><label>Date of Birth:</label></td>
            <td><input type="date"></td>
        </tr>
        <tr>
            <td> <label>Country:</label></td>
            <td>
                <select>
                    <option>India</option>
                    <option>USA</option>
                    <option>UK</option>
                    <option>Canada</option>
                </select>
            </td>
        </tr> <lable>uploa
        </lable>

        <tr>
            <td colspan="2">
                <input type="submit" value="Save My Data">
                <input type="reset" value="Reset Data">
            </td>
        </tr>

    </table>
</form>

</body>
</html>